{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":label(renovate)",
    ":reviewer(k35o)",
    ":timezone(Asia/Tokyo)",
    ":pinAllExceptPeerDependencies",
    "group:allNonMajor",
    "helpers:pinGitHubActionDigestsToSemver",
    ":automergeMinor"
  ],
  "rangeStrategy": "pin",
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  },
  "osvVulnerabilityAlerts": true,
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "matchDatasources": [
        "npm"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "k35o/pavo は自分のリポジトリで、main に数日おきにコミットが入る。digest の pin に待機期間を置くと最新の digest が7日を超えず、呼び出し側の pin が上がらない",
      "matchPackageNames": [
        "k35o/pavo"
      ],
      "minimumReleaseAge": null
    }
  ]
}
